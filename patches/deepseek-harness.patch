+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { MarkdownText } from '../src/markdown/MarkdownText.tsx'
+import { projectUserText } from '../src/user-text.tsx'
+import type { TextLink, TextLinks } from '../src/text-links.ts'
+import { markdownLabels as labels } from './labels.client.ts'
+
+afterEach(cleanup)
+
+function deferred() {
+  let resolve!: (links: readonly TextLink[]) => void
+  const promise = new Promise<readonly TextLink[]>((done) => { resolve = done })
+  return { promise, resolve }
+}
+
+describe('asynchronous display links', () => {
+  it('decorates UTF-16 prose ranges after resolution and preserves uncovered text', async () => {
+    const pending = deferred()
+    const links: TextLinks = { resolve: vi.fn(() => pending.promise), open: vi.fn() }
+    const source = '🙂 report.txt remains'
+    const view = render(<MarkdownText text={source} labels={labels} textLinks={links} />)
+    expect(view.container.textContent).toBe(source)
+    expect(screen.queryByRole('button')).toBeNull()
+    await act(async () => { pending.resolve([{ start: 3, end: 13, target: 'opaque', title: 'report' }]) })
+    fireEvent.click(screen.getByRole('button', { name: 'report.txt' }))
+    expect(links.open).toHaveBeenCalledWith('opaque')
+    expect(view.container.textContent).toBe(source)
+    expect([...view.container.querySelector('p')!.childNodes].map(node => ({
+      role: node instanceof HTMLButtonElement ? 'button' : 'text', text: node.textContent,
+    }))).toMatchInlineSnapshot(`
+      [
+        {
+          "role": "text",
+          "text": "🙂 ",
+        },
+        {
+          "role": "button",
+          "text": "report.txt",
+        },
+        {
+          "role": "text",
+          "text": " remains",
+        },
+      ]
+    `)
+  })
+
+  it('ignores obsolete text, callback, and unmount completions', async () => {
+    const first = deferred()
+    const second = deferred()
+    const third = deferred()
+    const links: TextLinks = { resolve: vi.fn().mockReturnValueOnce(first.promise).mockReturnValueOnce(second.promise), open: vi.fn() }
+    const view = render(<MarkdownText text="old" labels={labels} textLinks={links} />)
+    await waitFor(() => { expect(links.resolve).toHaveBeenCalledTimes(1) })
+    view.rerender(<MarkdownText text="new" labels={labels} textLinks={links} />)
+    await waitFor(() => { expect(links.resolve).toHaveBeenCalledTimes(2) })
+    await act(async () => { first.resolve([{ start: 0, end: 3, target: 'old' }]) })
+    expect(screen.queryByRole('button')).toBeNull()
+    const replacement: TextLinks = { resolve: () => third.promise, open: links.open }
+    view.rerender(<MarkdownText text="new" labels={labels} textLinks={replacement} />)
+    await act(async () => { second.resolve([{ start: 0, end: 3, target: 'second' }]) })
+    expect(view.container.textContent).toBe('new')
+    expect(screen.queryByRole('button')).toBeNull()
+    view.unmount()
+    await act(async () => { third.resolve([{ start: 0, end: 3, target: 'third' }]) })
+    expect(view.container.textContent).toBe('')
+  })
+
+  it('keeps rejected discovery inert and does not discover streaming text', async () => {
+    const links: TextLinks = { resolve: vi.fn(async () => { throw new Error('offline') }), open: vi.fn() }
+    const view = render(<MarkdownText text="report.txt" streaming labels={labels} textLinks={links} />)
+    view.rerender(<MarkdownText text="report.txt grows" streaming labels={labels} textLinks={links} />)
+    expect(links.resolve).not.toHaveBeenCalled()
+    await act(async () => { view.rerender(<MarkdownText text="report.txt" labels={labels} textLinks={links} />) })
+    expect(links.resolve).toHaveBeenCalledWith('report.txt', 'text')
+    expect(view.container.textContent).toBe('report.txt')
+    expect(screen.queryByRole('button')).toBeNull()
+  })
+
+  it('resolves exact inline code and authored destinations without nested controls or unsafe anchors', async () => {
+    const links: TextLinks = {
+      resolve: vi.fn<TextLinks['resolve']>(async (text, mode) => mode === 'target' && text === 'report.txt'
+        ? [{ start: 0, end: text.length, target: 'file' }] : []),
+      open: vi.fn(),
+    }
+    const source = '`report.txt` [report](report.txt) [`report.txt`](https://example.com) [bad](javascript:evil)'
+    const view = render(<MarkdownText text={source} labels={labels} textLinks={links} />)
+    await screen.findByRole('button', { name: 'report' })
+    expect(screen.getByRole('button', { name: 'report.txt' })).toBeTruthy()
+    const anchor = screen.getByRole('link')
+    expect(anchor.getAttribute('href')).toBe('https://example.com')
+    expect(anchor.getAttribute('rel')).toBe('noopener noreferrer')
+    expect(anchor.querySelector('button, a')).toBeNull()
+    expect(view.container.querySelector('[href^="javascript:"]')).toBeNull()
+    expect(links.resolve).not.toHaveBeenCalledWith('https://example.com', 'target')
+    expect(view.container.textContent).toBe('report.txt report report.txt bad')
+  })
+
+  it('requires the entire target and preserves legacy inline-code fallback', async () => {
+    const legacy = vi.fn()
+    const links: TextLinks = { resolve: async () => [{ start: 0, end: 2, target: 'partial' }], open: vi.fn() }
+    render(<MarkdownText text="`report.txt`" labels={labels} textLinks={links}
+      fileMentions={{ resolve: () => ({ open: legacy, label: 'legacy file', title: 'report.txt' }) }} />)
+    await act(async () => {})
+    fireEvent.click(screen.getByRole('button', { name: 'legacy file' }))
+    expect(legacy).toHaveBeenCalledOnce()
+    expect(links.open).not.toHaveBeenCalled()
+  })
+
+  it('keeps existing user chips and makes a known raw session reference clickable', async () => {
+    const source = '/plan @[Related](dsh-session:other) tail'
+    const links: TextLinks = {
+      resolve: async () => [{ start: 6, end: 35, target: 'session' }], open: vi.fn(),
+    }
+    const view = render(<div>{projectUserText(source, [], links)}</div>)
+    fireEvent.click(await screen.findByRole('button', { name: 'Related' }))
+    expect(links.open).toHaveBeenCalledWith('session')
+    expect(view.container.querySelector('[data-ref-chip="skill"]')?.textContent).toBe('/plan')
+    expect(view.container.textContent).toBe('/plan Related tail')
+  })
+})
