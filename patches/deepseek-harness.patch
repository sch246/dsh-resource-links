+/** Presentation-only links resolved by an owning feature. */
+export interface TextLink {
+  /** Inclusive UTF-16 offset in the supplied text. */
+  readonly start: number
+  /** Exclusive UTF-16 offset; ranges are ordered and non-overlapping. */
+  readonly end: number
+  /** Opaque target passed unchanged to the opener. */
+  readonly target: string
+  readonly title?: string
+  /** Optional display label replacing the matched text. */
+  readonly label?: string
+}
+
+/** Async decoration callbacks; no resource interpretation belongs to the renderer. */
+export interface TextLinks {
+  /**
+   * Resolve display ranges. Target mode accepts only a single complete range.
+   * @param text - Unmodified text or authored destination.
+   * @param mode - Prose discovery or exact-token resolution.
+   * @returns Ordered UTF-16 ranges; rejection leaves the text inert.
+   */
+  resolve: (text: string, mode: 'text' | 'target') => Promise<readonly TextLink[]>
+  /**
+   * Open a resolved target through the owner's error-handling channel.
+   * @param target - Opaque target returned by resolve.
+   */
+  open: (target: string) => void
+}
