+/** Component-private asynchronous decorations; obsolete completions cannot change rendered text. */
+import { Fragment, useEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import type { TextLink, TextLinks } from './text-links.ts'
+import css from './markdown/MarkdownText.module.css'
+
+interface Resolution {
+  text: string
+  mode: 'text' | 'target'
+  resolve: TextLinks['resolve']
+  links: readonly TextLink[]
+}
+
+/**
+ * Render resolved ranges with optional owner-local fallback projection.
+ * @param props - Text, stable callbacks, and owner-local fallback content.
+ * @returns Inline buttons and unchanged uncovered text.
+ */
+export function LinkedText({ text, mode = 'text', links, children, fallback, plain = identity }: {
+  text: string
+  mode?: 'text' | 'target'
+  links: TextLinks
+  children?: ReactNode
+  fallback?: ReactNode
+  plain?: (text: string) => ReactNode
+}): ReactNode {
+  const { resolve, open } = links
+  const [result, setResult] = useState<Resolution>()
+  useEffect(() => {
+    let active = true
+    void Promise.resolve().then(() => resolve(text, mode)).then(
+      (resolved) => { if (active) setResult({ text, mode, resolve, links: resolved }) },
+      () => {
+        // Optional decoration failure preserves the source and its ordinary projection.
+        if (active) setResult({ text, mode, resolve, links: [] })
+      },
+    )
+    return () => { active = false }
+  }, [text, mode, resolve])
+  const ranges = result?.text === text && result.mode === mode && result.resolve === resolve
+    ? result.links
+    : []
+  const button = (link: TextLink, content: ReactNode): ReactNode => (
+    <button key={link.start} type="button" className={css.fileMention} title={link.title}
+      onClick={() => { open(link.target) }}>
+      {content}
+    </button>
+  )
+  if (mode === 'target') {
+    const link = ranges.length === 1 ? ranges[0] : undefined
+    return link?.start === 0 && link.end === text.length
+      ? button(link, children ?? link.label ?? plain(text))
+      : fallback ?? children ?? plain(text)
+  }
+  const parts: ReactNode[] = []
+  let cursor = 0
+  for (const link of ranges) {
+    if (cursor < link.start) parts.push(<Fragment key={`plain-${cursor}`}>{plain(text.slice(cursor, link.start))}</Fragment>)
+    parts.push(button(link, link.label ?? plain(text.slice(link.start, link.end))))
+    cursor = link.end
+  }
+  if (cursor < text.length) parts.push(<Fragment key={`plain-${cursor}`}>{plain(text.slice(cursor))}</Fragment>)
+  return <>{parts}</>
+}
+
+function identity(text: string): string { return text }
