--- /dev/null
+++ b/packages/client/ui-chat/src/client/open-workspace-file.ts
@@ -0,0 +1,29 @@
+/** Shared Client workspace-file dispatch and native Host opening. */
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-api-remotes/client'
+import type {} from '@deepseek-ai/dsh-api-session-controller/client'
+import { resolveWorkspacePath } from '@deepseek-ai/dsh-util-workspace-path'
+import type { ChatFileOpenRequest } from './contract/slots.ts'
+
+/**
+ * Open a workspace file through Client handlers or the native Host application.
+ * System mode, whether explicit or supplied by policy, bypasses handlers.
+ * Listener and native failures reject without a second open attempt.
+ * @param ctx - Client context with sessions and remote.session injected.
+ * @param request - Addressed workspace path and caller-selected presentation intent.
+ * @returns Completion of the handling listener or native open operation.
+ */
+export async function openWorkspaceFile(ctx: Context, request: ChatFileOpenRequest): Promise<void> {
+  const openNative = async (): Promise<void> => {
+    const cwd = ctx.sessions.list.getSnapshot().byId[request.sessionId]?.cwd
+    const result = await ctx.remote.session.openWorkspacePath({
+      path: resolveWorkspacePath(cwd, request.path),
+    }, request.signal)
+    if (!result.ok) throw new Error(`path open failed: ${result.error.message}`)
+  }
+  if (request.mode === 'system' || ctx.get('workspaceFileOpenPolicy')?.mode === 'system') {
+    await openNative()
+    return
+  }
+  await ctx.waterfall('chat/open-workspace-file', request, openNative)
+}
