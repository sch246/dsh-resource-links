{
  "name": "@dsh-external/dsh-user-files",
  "version": "0.1.12",
  "description": "Authenticated user-file access with optional Markdown inline-code links",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./text-patch": {
      "types": "./lib/types/text-patch.d.ts",
      "default": "./lib/types/text-patch.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./file-location": {
      "types": "./lib/types/file-location.d.ts",
      "default": "./lib/types/file-location.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json",
    "./install": {
      "types": "./lib/types/install.d.ts",
      "default": "./lib/types/install.js"
    },
    "./transfer": {
      "types": "./lib/types/transfer-url.d.ts",
      "default": "./lib/types/transfer-url.js"
    },
    "./download": {
      "types": "./lib/types/download.d.ts",
      "default": "./lib/types/download.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.2 <1"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "mime-types": "^3.0.2",
    "semver": "^7.7.2",
    "diff": "8.0.4"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
