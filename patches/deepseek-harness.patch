+// @vitest-environment jsdom
+/** Shared workspace-file dispatch with real Cordis handlers and optional policy. */
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { ClientRemote } from '@deepseek-ai/dsh-api-remotes/client'
+import { RemoteError, TestRemote } from '@deepseek-ai/dsh-client-test-runtime'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { ChatFileOpenRequest } from '../src/client/contract/slots.ts'
+import { openWorkspaceFile } from '../src/client/open-workspace-file.ts'
+
+const SESSION = 'file-session' as SessionId
+const contexts: Context[] = []
+afterEach(async () => {
+  await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose()))
+})
+
+function bench() {
+  const ctx = new Context()
+  contexts.push(ctx)
+  ctx.provide('sessions', {
+    list: { getSnapshot: () => ({ byId: { [SESSION]: { cwd: '/workspace' } } }) },
+  } as never)
+  const native = vi.fn<ClientRemote['session']['openWorkspacePath']>(async () => ({
+    ok: true, value: { opened: true },
+  }))
+  new TestRemote(ctx, { session: { openWorkspacePath: native } })
+  return { ctx, native }
+}
+
+describe('workspace-file opening', () => {
+  it('opens once without a provider and resolves the addressed workspace', async () => {
+    const { ctx, native } = bench()
+    const signal = new AbortController().signal
+    await openWorkspaceFile(ctx, { sessionId: SESSION, path: 'report.md', signal })
+    expect(native).toHaveBeenCalledExactlyOnceWith({ path: '/workspace/report.md' }, signal)
+  })
+
+  it.each([
+    { groupId: 'group-1' },
+    { fromInstanceId: 'pane-1', direction: 'right' as const },
+  ])('preserves caller preview and target intent: %j', async (target) => {
+    const { ctx, native } = bench()
+    const handle = vi.fn<(request: ChatFileOpenRequest, next: () => Promise<void>) => Promise<void>>(async () => {})
+    ctx.on('chat/open-workspace-file', handle)
+    const request: ChatFileOpenRequest = {
+      sessionId: SESSION, path: 'report.md', preview: false, target, signal: new AbortController().signal,
+    }
+    await openWorkspaceFile(ctx, request)
+    expect(handle).toHaveBeenCalledExactlyOnceWith(request, expect.any(Function))
+    expect(handle.mock.calls[0]?.[0]).toBe(request)
+    expect(native).not.toHaveBeenCalled()
+  })
+
+  it('delegates through handlers and preserves absolute paths', async () => {
+    const { ctx, native } = bench()
+    ctx.on('chat/open-workspace-file', async (_request, next) => next())
+    await openWorkspaceFile(ctx, { sessionId: SESSION, path: '/other/report.md' })
+    expect(native).toHaveBeenCalledExactlyOnceWith({ path: '/other/report.md' }, undefined)
+  })
+
+  it('bypasses handlers for explicit system mode despite preview policy', async () => {
+    const { ctx, native } = bench()
+    ctx.provide('workspaceFileOpenPolicy', { mode: 'preview' })
+    const handle = vi.fn<(request: ChatFileOpenRequest, next: () => Promise<void>) => Promise<void>>(async () => {})
+    ctx.on('chat/open-workspace-file', handle)
+    await openWorkspaceFile(ctx, { sessionId: SESSION, path: '.', mode: 'system' })
+    expect(handle).not.toHaveBeenCalled()
+    expect(native).toHaveBeenCalledExactlyOnceWith({ path: '/workspace/.' }, undefined)
+  })
+
+  it('reads optional policy at each call and follows handler disposal', async () => {
+    const { ctx, native } = bench()
+    const handle = vi.fn<(request: ChatFileOpenRequest, next: () => Promise<void>) => Promise<void>>(async () => {})
+    const handler = await ctx.plugin((child) => { child.on('chat/open-workspace-file', handle) })
+    const policy = await ctx.plugin((child) => { child.provide('workspaceFileOpenPolicy', { mode: 'system' }) })
+    await openWorkspaceFile(ctx, { sessionId: SESSION, path: '.', mode: 'default' })
+    expect(handle).not.toHaveBeenCalled()
+    expect(native).toHaveBeenCalledOnce()
+    await policy.dispose()
+    await openWorkspaceFile(ctx, { sessionId: SESSION, path: '.' })
+    expect(handle).toHaveBeenCalledOnce()
+    expect(native).toHaveBeenCalledOnce()
+    await handler.dispose()
+    await openWorkspaceFile(ctx, { sessionId: SESSION, path: '.' })
+    expect(native).toHaveBeenCalledTimes(2)
+  })
+
+  it('propagates listener rejection without opening natively', async () => {
+    const { ctx, native } = bench()
+    const failure = new Error('viewer refused')
+    ctx.on('chat/open-workspace-file', async () => { throw failure })
+    await expect(openWorkspaceFile(ctx, { sessionId: SESSION, path: '.' })).rejects.toBe(failure)
+    expect(native).not.toHaveBeenCalled()
+  })
+
+  it('preserves native refusal and transport rejection without retries', async () => {
+    const { ctx, native } = bench()
+    native.mockResolvedValueOnce({ ok: false, error: new RemoteError('gateway/internal', 'opener missing', {}) })
+    await expect(openWorkspaceFile(ctx, { sessionId: SESSION, path: '.' }))
+      .rejects.toThrow('path open failed: opener missing')
+    const failure = new Error('disconnected')
+    native.mockRejectedValueOnce(failure)
+    await expect(openWorkspaceFile(ctx, { sessionId: SESSION, path: '.', mode: 'system' })).rejects.toBe(failure)
+    expect(native).toHaveBeenCalledTimes(2)
+  })
+})
